# Copy to .env (gitignored) and adjust. Real environment variables take precedence.
# Folder containing train/ and test/ (default: <repo>/6ab10eb3b23ba_student_resource/student_resource/dataset)
ER_DATA_DIR=
# Where outputs, parquet cache, split files and candidates are written (default: <repo>/output)
ER_OUTPUT_DIR=
# Threads for sparse top-k and parallel hashing (default: CPU count - 1; >4 gives little for top-k, which is memory-bandwidth bound)
ER_N_JOBS=
